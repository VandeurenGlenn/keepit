{
    "compilerOptions": {
        "module": "nodenext",
        "target": "ES2022",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "declaration": false,
        "outDir": "www",
        "types": [
            "@material/web/all.d.ts",
            "@vandeurenglenn/lite"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "src/**/*.test.ts",
        "src/tests/**/*"
    ]
}
